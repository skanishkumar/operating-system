#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, f, head, alloc, sched, i;
    int blocks[20], seek = 0;
    printf("Disk Blocks: ");
    scanf("%d", &n);
    printf("File Size: ");
    scanf("%d", &f);
    printf("Head Position: ");
    scanf("%d", &head);
    printf("1-Contiguous  2-Indexed : ");
    scanf("%d", &alloc);
    printf("1-FCFS  2-SSTF : ");
    scanf("%d", &sched);
    if(f > n) {
        printf("Allocation Failed");
        return 0;
    }
    printf("\nAllocated Blocks: ");
    if(alloc == 1) {        // Contiguous
        for(i = 0; i < f; i++) {
            blocks[i] = i;
            printf("%d ", blocks[i]);
        }
    }
    else {                  // Indexed
        printf("Index[0] -> ");
        for(i = 0; i < f; i++) {
            blocks[i] = i + 1;
            printf("%d ", blocks[i]);
        }
    }
    printf("\nSeek Sequence: %d ", head);
    int cur = head;
    if(sched == 1) {        // FCFS
        for(i = 0; i < f; i++) {
            seek += abs(cur - blocks[i]);
            cur = blocks[i];
            printf("-> %d ", cur);
        }
    }
    else {                  // SSTF
        int vis[20] = {0};
        for(i = 0; i < f; i++) {
            int min = 9999, pos = -1, j;
            for(j = 0; j < f; j++) {
                if(!vis[j] && abs(cur - blocks[j]) < min) {
                    min = abs(cur - blocks[j]);
                    pos = j;
                }
            }
            vis[pos] = 1;
            seek += min;
            cur = blocks[pos];
            printf("-> %d ", cur);
        }
    }
    printf("\nTotal Seek Time = %d", seek);
    printf("\nBest Combination: ");
    if(alloc == 2 && sched == 2)
        printf("Indexed + SSTF");
    else
        printf("Try Indexed + SSTF for better performance");
    return 0;
}
INPUT:

Disk Blocks: 10
File Size: 4
Head Position: 5
1-Contiguous  2-Indexed : 2
1-FCFS  2-SSTF : 2

OUTOUT :

Allocated Blocks:
Index[0] -> 1 2 3 4

Seek Sequence:
5 -> 4 -> 3 -> 2 -> 1

Total Seek Time = 4

Best Combination: Indexed + SSTF
