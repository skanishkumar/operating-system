QUESTION 2:
#include <stdio.h>

int main() {
    int n, b[100], req, i, count = 0;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter bitmap (0-Free, 1-Allocated):\n");
    for(i = 0; i < n; i++)
        scanf("%d", &b[i]);

    printf("Blocks to allocate: ");
    scanf("%d", &req);

    for(i = 0; i < n && count < req; i++) {
        if(b[i] == 0) {
            b[i] = 1;
            count++;
        }
    }

    if(count < req)
        printf("Not enough free space\n");
    else {
        printf("Bitmap after allocation:\n");
        for(i = 0; i < n; i++)
            printf("%d ", b[i]);
    }

    int block;
    printf("\nEnter block to deallocate: ");
    scanf("%d", &block);

    if(block >= 0 && block < n)
        b[block] = 0;

    printf("Bitmap after deallocation:\n");
    for(i = 0; i < n; i++)
        printf("%d ", b[i]);

    return 0;
}
INPUT:
Enter number of blocks: 8
Enter bitmap:
0 1 0 0 1 0 0 1
Blocks to allocate: 2
Enter block to deallocate: 1

OUTPUT:
Bitmap after allocation:
1 1 1 0 1 1 0 1

Bitmap after deallocation:
1 0 1 0 1 1 0 1

