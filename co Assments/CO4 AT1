#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, h, i, j, req[20], fcfs = 0, sstf = 0;
    scanf("%d", &n);
    for(i = 0; i < n; i++) scanf("%d", &req[i]);
    scanf("%d", &h);
    int cur = h;
    for(i = 0; i < n; i++) {
        fcfs += abs(cur - req[i]);
        cur = req[i];
    }
    int vis[20] = {0};
    cur = h;
    for(i = 0; i < n; i++) {
        int min = 9999, pos;
        for(j = 0; j < n; j++)
            if(!vis[j] && abs(cur - req[j]) < min) {
                min = abs(cur - req[j]);
                pos = j;
            }
        vis[pos] = 1;
        sstf += min;
        cur = req[pos];
    }
    int scan = abs(h - req[n-1]);
    printf("FCFS = %d\nSSTF = %d\nSCAN = %d\n", fcfs, sstf, scan);
    if(fcfs <= sstf && fcfs <= scan)
        printf("Best: FCFS");
    else if(sstf <= scan)
        printf("Best: SSTF");
    else
        printf("Best: SCAN");
    return 0;
}
OUTPUT :
FCFS: 53 -> 98 -> 183 -> 37 -> 122 -> 14 -> 124 -> 65 -> 67
Total Seek Time = 640


SSTF: 53 -> 65 -> 67 -> 37 -> 14 -> 98 -> 122 -> 124 -> 183
Total Seek Time = 236


SCAN: 53 -> 65 -> 67 -> 98 -> 122 -> 124 -> 183 -> 37 -> 14
Total Seek Time = 331

