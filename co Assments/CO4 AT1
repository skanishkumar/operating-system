#include <stdio.h>
#include <stdlib.h>
int main() {
    int n, req[20], head, i;
    int cscan = 0, look = 0;
    printf("Enter no. of requests: ");
    scanf("%d", &n);
    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);
    printf("Enter head position: ");
    scanf("%d", &head);
    int max = req[0], min = req[0];
    for(i = 1; i < n; i++) {
        if(req[i] > max) max = req[i];
        if(req[i] < min) min = req[i];
    }
    look = (max - head) + (max - min);
    cscan = (199 - head) + 199 + max;
    printf("\nLOOK Head Movement = %d", look);
    printf("\nC-SCAN Head Movement = %d", cscan);
    if(look < cscan)
        printf("\nBetter Algorithm: LOOK");
    else
        printf("\nBetter Algorithm: C-SCAN");
    return 0;
}
