#include <stdio.h>
int main() {
    int n, f, c, i;
    scanf("%d%d%d", &n, &f, &c);
    if (f > n) {
        printf("Allocation not possible");
        return 0;
    }
    switch(c) {
        case 1:
            for(i = 0; i < f; i++) printf("%d ", i);
            break;
        case 2:
            for(i = 0; i < f; i++) printf("%d->", i);
            printf("NULL");
            break;
        case 3:
            printf("Index:0\n");
            for(i = 1; i <= f; i++) printf("%d ", i);
            break;
        default:
            printf("Invalid Choice");
    }
    return 0;
}
