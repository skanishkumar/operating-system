Question 4:

#include <stdio.h>

int main() {
    float memAccessTime, tlbAccessTime, hitRatio;
    float withTLB, withoutTLB;
    printf("Enter Memory Access Time: ");
    scanf("%f", &memAccessTime);
    printf("Enter TLB Access Time: ");
    scanf("%f", &tlbAccessTime);
    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);
    withoutTLB = 2 * memAccessTime;
    withTLB = hitRatio * (tlbAccessTime + memAccessTime)
            + (1 - hitRatio) * (tlbAccessTime + 2 * memAccessTime);
    printf("Without TLB = %.2f\n", withoutTLB);
    printf("With TLB = %.2f\n", withTLB);
    return 0;
}

