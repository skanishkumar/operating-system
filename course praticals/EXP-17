#include <stdio.h>

int main()
{
    int alloc[5][3], max[5][3], need[5][3];
    int avail[3];
    int finish[5]={0};
    int safe[5];
    int count=0;

    printf("Enter Allocation Matrix:\n");
    for(int i=0;i<5;i++)
        for(int j=0;j<3;j++)
            scanf("%d",&alloc[i][j]);

    printf("Enter Max Matrix:\n");
    for(int i=0;i<5;i++)
        for(int j=0;j<3;j++)
            scanf("%d",&max[i][j]);

    printf("Enter Available Resources:\n");
    for(int i=0;i<3;i++)
        scanf("%d",&avail[i]);

    for(int i=0;i<5;i++)
        for(int j=0;j<3;j++)
            need[i][j]=max[i][j]-alloc[i][j];

    while(count<5)
    {
        for(int i=0;i<5;i++)
        {
            if(!finish[i])
            {
                int flag=1;

                for(int j=0;j<3;j++)
                {
                    if(need[i][j]>avail[j])
                    {
                        flag=0;
                        break;
                    }
                }

                if(flag)
                {
                    safe[count++]=i;

                    for(int j=0;j<3;j++)
                        avail[j]+=alloc[i][j];

                    finish[i]=1;
                }
            }
        }
    }

    printf("Safe Sequence: ");

    for(int i=0;i<5;i++)
        printf("P%d ",safe[i]);

    return 0;
}
