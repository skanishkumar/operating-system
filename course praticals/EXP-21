#include <stdio.h>

int main()
{
    int nb,np;
    int block[20],process[20],allocation[20];

    printf("Enter number of memory blocks: ");
    scanf("%d",&nb);

    for(int i=0;i<nb;i++)
        scanf("%d",&block[i]);

    printf("Enter number of processes: ");
    scanf("%d",&np);

    for(int i=0;i<np;i++)
        scanf("%d",&process[i]);

    for(int i=0;i<np;i++)
    {
        int worst=-1;

        for(int j=0;j<nb;j++)
        {
            if(block[j]>=process[i])
            {
                if(worst==-1 || block[j]>block[worst])
                    worst=j;
            }
        }

        allocation[i]=worst;

        if(worst!=-1)
            block[worst]-=process[i];
    }

    printf("\nProcess\tBlock\n");
    for(int i=0;i<np;i++)
        printf("%d\t%d\n",i+1,allocation[i]+1);

    return 0;
}
