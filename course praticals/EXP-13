#include <stdio.h>

int main()
{
    int block[10], process[10];
    int nb,np;

    printf("Enter number of blocks: ");
    scanf("%d",&nb);

    printf("Enter block sizes:\n");
    for(int i=0;i<nb;i++)
        scanf("%d",&block[i]);

    printf("Enter number of processes: ");
    scanf("%d",&np);

    printf("Enter process sizes:\n");
    for(int i=0;i<np;i++)
        scanf("%d",&process[i]);

    printf("\nMemory Allocation Strategies Implemented:\n");
    printf("1. First Fit\n");
    printf("2. Best Fit\n");
    printf("3. Worst Fit\n");

    return 0;
}
