#include <stdio.h>

int main()
{
    int nb,np;
    int block[20],process[20],allocation[20];

    scanf("%d",&nb);

    for(int i=0;i<nb;i++)
        scanf("%d",&block[i]);

    scanf("%d",&np);

    for(int i=0;i<np;i++)
        scanf("%d",&process[i]);

    for(int i=0;i<np;i++)
    {
        allocation[i]=-1;

        for(int j=0;j<nb;j++)
        {
            if(block[j]>=process[i])
            {
                allocation[i]=j;
                block[j]-=process[i];
                break;
            }
        }
    }

    printf("Process\tBlock\n");

    for(int i=0;i<np;i++)
        printf("%d\t%d\n",i+1,allocation[i]+1);

    return 0;
}
