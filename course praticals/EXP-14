#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][20];
    int n;

    printf("Enter number of files: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++)
    {
        printf("File %d: ",i+1);
        scanf("%s",files[i]);
    }

    printf("\nFiles in Directory:\n");

    for(int i=0;i<n;i++)
        printf("%s\n",files[i]);

    return 0;
}
