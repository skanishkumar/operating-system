    printf("=====================================================================\n");
    printf(" CSA04 OS ASSIGNMENT - TEAM 1: ONLINE FOOD DELIVERY APP\n");
    printf(" PART III: DISK SCHEDULING\n");
    printf("=====================================================================\n");

    int req[DQ] = {55, 18, 90, 66, 32, 75, 10, 88};
    int head = 40;
    printf("\nDisk Queue: 55,18,90,66,32,75,10,88 | Head Start = %d | Cylinders = 0-%d\n", head, CYL_MAX);

    diskFCFS(req, DQ, head);
    diskSSTF(req, DQ, head);
    diskSCAN(req, DQ, head, CYL_MAX);
    diskCSCAN(req, DQ, head, CYL_MAX);

    printf("\n=====================================================================\n");
    printf(" END OF PART III SIMULATION\n");
    printf("=====================================================================\n");
    return 0;
}
