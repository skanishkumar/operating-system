#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define N 5          /* number of processes */
#define QUANTUM 2    /* Round Robin time quantum */

typedef struct {
    char  name[6];
    int   at;    /* arrival time */
    int   bt;    /* burst time   */
    int   pr;    /* priority (1 = highest) */
    int   ct, tat, wt;  /* completion, turnaround, waiting */
} Process;

/* ---------- helper: print a Gantt-chart-style timeline ---------- */
void printGantt(char order[][6], int start[], int end[], int n) {
    int i;
    printf("\nGantt Chart:\n ");
    for (i = 0; i < n; i++) printf("_______");
    printf("\n|");
    for (i = 0; i < n; i++) printf("  %-4s|", order[i]);
    printf("\n ");
    for (i = 0; i < n; i++) printf("_______");
    printf("\n%d", start[0]);
    for (i = 0; i < n; i++) printf("      %d", end[i]);
    printf("\n");
}

/* Process set mapped to Online Food Delivery App backend requests:
   P1 = Order Placement Request
   P2 = Payment Gateway Processing
   P3 = Restaurant Order Confirmation
   P4 = Delivery Partner Assignment
   P5 = Live Order Tracking Update
   Priorities (1 = highest) assigned by business criticality:
   P2(1) > P1(2) > P4(3) > P3(4) > P5(5)                         */
void resetProcesses(Process p[]) {
    strcpy(p[0].name, "P1"); p[0].at = 0; p[0].bt = 4; p[0].pr = 2;
    strcpy(p[1].name, "P2"); p[1].at = 1; p[1].bt = 3; p[1].pr = 1;
    strcpy(p[2].name, "P3"); p[2].at = 2; p[2].bt = 5; p[2].pr = 4;
    strcpy(p[3].name, "P4"); p[3].at = 3; p[3].bt = 2; p[3].pr = 3;
    strcpy(p[4].name, "P5"); p[4].at = 4; p[4].bt = 6; p[4].pr = 5;
}

void printSummary(Process p[], int n, const char *algoName) {
    int i;
    float totalTAT = 0, totalWT = 0;
    printf("\n--- %s : Result Table ---\n", algoName);
    printf("%-5s %-6s %-6s %-6s %-6s %-6s %-6s\n",
           "Proc", "AT", "BT", "CT", "TAT", "WT", "PR");
    for (i = 0; i < n; i++) {
        printf("%-5s %-6d %-6d %-6d %-6d %-6d %-6d\n",
               p[i].name, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt, p[i].pr);
        totalTAT += p[i].tat;
        totalWT  += p[i].wt;
    }
    printf("Average Turnaround Time = %.2f\n", totalTAT / n);
    printf("Average Waiting Time    = %.2f\n", totalWT / n);
}

/* ============================ FCFS ============================ */
void fcfs() {
    Process p[N]; resetProcesses(p);
    int i, j;
    for (i = 0; i < N - 1; i++)
        for (j = 0; j < N - 1 - i; j++)
            if (p[j].at > p[j + 1].at) { Process t = p[j]; p[j] = p[j + 1]; p[j + 1] = t; }

    char order[N][6]; int start[N], end[N];
    int time = 0;
    for (i = 0; i < N; i++) {
        if (time < p[i].at) time = p[i].at;
        start[i] = time;
        time += p[i].bt;
        end[i] = time;
        p[i].ct  = time;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt  = p[i].tat - p[i].bt;
        strcpy(order[i], p[i].name);
    }
    printf("\n================ FCFS SCHEDULING ================\n");
    printGantt(order, start, end, N);
    printSummary(p, N, "FCFS");
}

/* ======================= SJF (non-preemptive) ==================== */
void sjf() {
    Process p[N]; resetProcesses(p);
    int done[N]; memset(done, 0, sizeof(done));
    int time = 0, completed = 0;
    char order[N][6]; int start[N], end[N]; int idx = 0;

    while (completed < N) {
        int sel = -1, minBT = 1000000;
        int i;
        for (i = 0; i < N; i++) {
            if (!done[i] && p[i].at <= time && p[i].bt < minBT) {
                minBT = p[i].bt; sel = i;
            }
        }
        if (sel == -1) { time++; continue; }
        start[idx] = time;
        time += p[sel].bt;
        end[idx] = time;
        p[sel].ct = time;
        p[sel].tat = p[sel].ct - p[sel].at;
        p[sel].wt  = p[sel].tat - p[sel].bt;
        strcpy(order[idx], p[sel].name);
        done[sel] = 1; completed++; idx++;
    }
    printf("\n================ SJF (NON-PREEMPTIVE) ================\n");
    printGantt(order, start, end, N);
    printSummary(p, N, "SJF (Non-Preemptive)");
}

/* ==================== Priority (non-preemptive) =================== */
void priorityScheduling() {
    Process p[N]; resetProcesses(p);
    int done[N]; memset(done, 0, sizeof(done));
    int time = 0, completed = 0;
    char order[N][6]; int start[N], end[N]; int idx = 0;

    while (completed < N) {
        int sel = -1, best = 1000000;
        int i;
        for (i = 0; i < N; i++) {
            if (!done[i] && p[i].at <= time && p[i].pr < best) {
                best = p[i].pr; sel = i;
            }
        }
        if (sel == -1) { time++; continue; }
        start[idx] = time;
        time += p[sel].bt;
        end[idx] = time;
        p[sel].ct = time;
        p[sel].tat = p[sel].ct - p[sel].at;
        p[sel].wt  = p[sel].tat - p[sel].bt;
        strcpy(order[idx], p[sel].name);
        done[sel] = 1; completed++; idx++;
    }
    printf("\n================ PRIORITY SCHEDULING ================\n");
    printf("(Priority 1 = highest, assigned per domain criticality:\n");
    printf(" P2-Payment=1, P1-Order=2, P4-Delivery=3, P3-Confirm=4, P5-Tracking=5)\n");
    printGantt(order, start, end, N);
    printSummary(p, N, "Priority Scheduling");
}

/* ============================ Round Robin ============================ */
void roundRobin() {
    Process p[N]; resetProcesses(p);
    int rem[N], i;
    for (i = 0; i < N; i++) rem[i] = p[i].bt;

    int time, completed = 0;
    int queue[100], front = 0, rear = 0;

    int order_idx[N];
    for (i = 0; i < N; i++) order_idx[i] = i;
    int a, b;
    for (a = 0; a < N - 1; a++)
        for (b = 0; b < N - 1 - a; b++)
            if (p[order_idx[b]].at > p[order_idx[b + 1]].at) {
                int t = order_idx[b]; order_idx[b] = order_idx[b + 1]; order_idx[b + 1] = t;
            }

    int ptr = 0;
    time = p[order_idx[0]].at;
    queue[rear++] = order_idx[0]; ptr = 1;

    char ganttName[200][6]; int ganttStart[200], ganttEnd[200]; int g = 0;

    while (completed < N) {
        int cur = queue[front++];
        int start = time;
        int run = (rem[cur] < QUANTUM) ? rem[cur] : QUANTUM;
        time += run;
        rem[cur] -= run;

        strcpy(ganttName[g], p[cur].name);
        ganttStart[g] = start; ganttEnd[g] = time; g++;

        while (ptr < N && p[order_idx[ptr]].at <= time) {
            queue[rear++] = order_idx[ptr]; ptr++;
        }

        if (rem[cur] > 0) {
            queue[rear++] = cur;
        } else {
            p[cur].ct = time;
            p[cur].tat = p[cur].ct - p[cur].at;
            p[cur].wt  = p[cur].tat - p[cur].bt;
            completed++;
        }

        if (front == rear && completed < N && ptr < N) {
            time = p[order_idx[ptr]].at;
            queue[rear++] = order_idx[ptr]; ptr++;
        }
    }

    printf("\n================ ROUND ROBIN (Quantum = %d) ================\n", QUANTUM);
    printGantt(ganttName, ganttStart, ganttEnd, g);
    printSummary(p, N, "Round Robin");
}

